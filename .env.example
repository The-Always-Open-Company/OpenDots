# Pods template: the UI opens in setup state until these fields are configured.
HOST=127.0.0.1
PORT=4310
# Pages, Pods and full conversation history live in this SQLite database.
DATABASE_PATH=data/opendots.sqlite
# Keep OWNER_ID stable: it owns the stored conversations.
OWNER_ID=opendots-owner
# npm run dev allows http://localhost:5173 and http://127.0.0.1:5173.
# APP_ORIGIN replaces these defaults with comma-separated exact origins.
# Include scheme, hostname and port; omit paths and trailing slashes.
# APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Required for an external HOST binding (24+ characters); enables local login too.
# OWNER_TOKEN=

# Any OpenAI-compatible chat-completions endpoint works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Model for conversations.
OPENAI_MODEL=gpt-6.1-sol
# API used for conversations: chat-completions or responses. gpt-6.1-sol only
# calls tools through responses; use chat-completions for other endpoints.
OPENAI_API=responses
# Older turns are summarized once history exceeds this estimated token budget
# (characters / 4; default 100000, minimum 4000).
# CONTEXT_MAX_TOKENS=100000
# Model used for those summaries; defaults to OPENAI_MODEL.
SUMMARY_MODEL=gpt-5.4-mini
# Model for simple turns, for background tasks, and for splitting requests into
# task briefs. Defaults to gpt-6-luna. "off" keeps every turn and task on the
# reasoning model. Turns use OPENAI_API; briefs use chat completions.
# FAST_MODEL=gpt-6-luna
# Decisions API model. Only gpt-6-luna answers these questions today, and that
# is the default. "off" skips classification. It chooses FAST_MODEL or
# OPENAI_MODEL, spots messages with several requests, and spots corrections
# during calls. Calls time out after 2.5 s; a slow call is sent again after
# 400 ms and the first answer wins.
# DECISIONS_MODEL=gpt-6-luna
# Lowest "simple" confidence (0-1) that sends a main chat turn to FAST_MODEL;
# default 0.8. Background tasks use FAST_MODEL unless rated "reasoning".
# ROUTER_MIN_CONFIDENCE=0.8
# "on" (default) splits a chat message or call request with several separate
# requests into tasks that run in parallel; "off" keeps one task per request.
# TASK_SPLIT=on
# Model turns per reply (2-100). Unset or "off" means no limit; each reply is
# still stopped after 90 seconds. With a limit, the last turn must answer.
# MAX_AGENT_TURNS=off
# Rarely used tools (plugins, computer, schedules...) are listed by name and
# sent to the model only after it asks for them. "off" sends every tool.
# LAZY_TOOLS=on
# Set to 1 to log estimated prompt and tool tokens for each reply.
# LOG_CONTEXT_SIZE=

# Learned per-Pod memories and the document library use Postgres with pgvector.
# compose.yml runs Postgres and docling-serve and sets DATABASE_URL/DOCLING_URL.
# Use a URL-safe password, for example: openssl rand -hex 24
POSTGRES_PASSWORD=
# For npm run dev, start compose.dev.yml and point at its loopback ports:
# DATABASE_URL=postgres://opendots:<POSTGRES_PASSWORD>@127.0.0.1:5433/opendots
# DOCLING_URL=http://127.0.0.1:5001
# Must return 1536-dimension vectors. Document text is sent to OPENAI_BASE_URL.
# EMBEDDING_MODEL=text-embedding-3-small
# Model that extracts learned memories after each turn; defaults to OPENAI_MODEL.
MEMORY_MODEL=gpt-5.4-mini
# Model that writes document summaries, tags and passage context while indexing;
# defaults to OPENAI_MODEL. Document sections are sent to OPENAI_BASE_URL.
ENRICHMENT_MODEL=gpt-5.4-mini
# Model that plans document searches and reranks passages each turn; defaults to
# OPENAI_MODEL. A small, fast model keeps replies quick.
RERANK_MODEL=gpt-5.4-mini
# Uploaded originals and converted text; defaults to documents/ beside the database.
# DOCUMENTS_DIR=data/documents
# MAX_UPLOAD_MB=50
# Seconds docling-serve may spend on one document before it is marked failed.
# DOCLING_MAX_DOCUMENT_TIMEOUT=900

# Optional isolated read-only public-page browser for WEB_SEARCH_PROVIDER=browser.
BROWSER_URL=http://127.0.0.1:4311
BROWSER_SECRET=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=4311
# Use the same random 24+ character secret in app/browser. All redirects are blocked.
# Supply canonical public URLs. Use the separate browser container for isolation.

# Optional voice calls; work asked for during a call runs in the same stored
# conversation. live (default) uses GPT-Live; realtime uses the older Realtime API.
VOICE_API_KEY=
# VOICE_PROVIDER=live
# Model that listens and speaks; defaults to gpt-live-1 for live and is
# required for realtime (for example gpt-realtime-2.1).
# VOICE_MODEL=gpt-live-1
VOICE_NAME=marin
# Model for the Pod turns a call delegates; defaults to OPENAI_MODEL. A faster
# model shortens spoken answers' wait. Uses OPENAI_BASE_URL and OPENAI_API.
# VOICE_TASK_MODEL=gpt-5.4-mini
# Delegated turns per call (1-100, or off for no limit; default 20). Failed
# turns count too. Calls still end after 15 minutes.
# VOICE_TASK_LIMIT=20
# Call tasks that run at once (1-10; default 3). Related requests still wait
# for the task they follow up.
# VOICE_TASK_CONCURRENCY=3
# How finished tasks reach the call: sequential (default; one spoken result at a
# time), batch (results that finish together share one spoken summary) or quiet
# (results are passed to the voice model without being spoken).
# VOICE_RESULT_DELIVERY=sequential
# Silence on the line, in milliseconds, before a result is sent (default 1000).
# VOICE_QUIET_MS=1000
# How long tasks may keep running after the call ends; their results go to the
# chat with a notification (milliseconds; default 600000).
# VOICE_TASK_AFTER_CALL_MS=600000
# Voice notes need only VOICE_API_KEY. Audio is sent to OpenAI for
# transcription and is not stored; spoken replies use VOICE_NAME.
# VOICE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# VOICE_SPEECH_MODEL=gpt-4o-mini-tts

# Optional persistent computers, one per Pod, using OpenBot services.
# See docs/COMPUTERS.md. Keep these two different random secrets on the server.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Keep stable: the namespace identifies existing containers and persistent volumes.
COMPUTER_NAMESPACE=opendots
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock

# Public-web provider. parallel (default), browser (URL-only), or disabled.
# Queries and selected URLs are sent to Parallel; sample mode makes no provider calls.
WEB_SEARCH_PROVIDER=parallel
# Optional Bearer key for production/higher limits; anonymous MCP supports light use.
PARALLEL_API_KEY=

# Encrypts plugin tokens, secret MCP URLs and OAuth refresh tokens saved from
# the Plugins page. 32 bytes, base64: openssl rand -base64 32
# Keep it stable; changing it makes saved credentials unreadable.
PLUGIN_SECRET_KEY=
